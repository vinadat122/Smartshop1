@page
@{
    ViewData["Title"] = "SmartShop - Review Report";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SmartShop - Review Report</title>
    <style>
            body {
                font-family: Arial, sans-serif;
                background: #f4f6f9;
                margin: 0;
                padding: 32px;
                color: #222;
            }

            .container {
                max-width: 1200px;
                margin: auto;
            }

            h1 { margin-bottom: 8px; }
            .subtitle { color: #666; margin-bottom: 24px; }

            .table-wrap {
                background: white;
                padding: 20px;
                border-radius: 12px;
                overflow-x: auto;
                box-shadow: 0 2px 10px #0000000d;
            }

            table {
                border-collapse: collapse;
                width: 100%;
                min-width: 750px;
            }

            th, td {
                padding: 14px;
                border-bottom: 1px solid #eee;
                text-align: left;
            }

            th { background: #f8fafc; }
            .positive { color: #15803d; font-weight: bold; }
            .negative { color: #dc2626; font-weight: bold; }
            .neutral { color: #64748b; font-weight: bold; }

            button {
                padding: 10px 16px;
                background: #2563eb;
                color: white;
                border: 0;
                border-radius: 6px;
                cursor: pointer;
                margin-bottom: 16px;
            }

            #status { margin: 12px 0; color: #555; }
    </style>
</head>
<body>
    <div class="container">
        <h1>SmartShop Review Report</h1>
        <p class="subtitle">
            Tổng hợp đánh giá và mức độ hài lòng của khách hàng theo sản phẩm.
        </p>

        <button onclick="loadReport()">Refresh report</button>
        <p id="status">Đang tải dữ liệu...</p>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Sản phẩm</th>
                        <th>Tổng đánh giá</th>
                        <th>Tích cực</th>
                        <th>Tiêu cực</th>
                        <th>Trung lập</th>
                        <th>Điểm trung bình</th>
                    </tr>
                </thead>
                <tbody id="reportBody"></tbody>
            </table>
        </div>
    </div>

    <script>
            async function loadReport() {
                const status = document.getElementById("status");
                const tbody = document.getElementById("reportBody");

                status.textContent = "Đang tải dữ liệu...";
                tbody.replaceChildren();

                try {
                    const response = await fetch("/api/reports/reviews");

                    if (!response.ok) {
                        throw new Error("Không lấy được dữ liệu báo cáo.");
                    }

                    const data = await response.json();

                    for (const item of data) {
                        const row = document.createElement("tr");

                        const values = [
                            item.productId,
                            item.productName,
                            item.totalReviews,
                            item.positive,
                            item.negative,
                            item.neutral,
                            Number(item.averageRating).toFixed(2)
                        ];

                        values.forEach((value, index) => {
                            const cell = document.createElement("td");
                            cell.textContent = value ?? "";

                            if (index === 3) cell.className = "positive";
                            if (index === 4) cell.className = "negative";
                            if (index === 5) cell.className = "neutral";

                            row.appendChild(cell);
                        });

                        tbody.appendChild(row);
                    }

                    status.textContent = `Đã tải ${data.length} sản phẩm.`;
                } catch (error) {
                    status.textContent = error.message;
                }
            }

            loadReport();
    </script>
</body>
</html>
